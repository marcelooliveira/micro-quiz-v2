{
  "configurations": [
    {
      "name": "SAM: start local API",
      "type": "node-terminal",
      "request": "launch",
      "command": "sam local start-api -d 5858",
      "cwd": "${workspaceFolder}/src/micro-quiz-v2",
      "preLaunchTask": "sam: build"
    },
    {
        "name": "Attach to SAM Local",
        "type": "node",
        "request": "attach",
        "address": "127.0.0.1",
        "port": 5858,
        "localRoot": "${workspaceFolder}/src/micro-quiz-v2/.aws-sam/build/AnswerSubmissionFunction",
        "remoteRoot": "/var/task",
        "sourceMaps": true,
        "sourceMapPathOverrides": {
            "../*": "${workspaceFolder}/src/micro-quiz-v2/answer-submission/*"
        }
    },
    {
      "type": "aws-sam",
      "request": "direct-invoke",
      "name": "micro-quiz-v2:HelloWorldFunction (nodejs24.x)",
      "invokeTarget": {
        "target": "template",
        "templatePath": "${workspaceFolder}/src/micro-quiz-v2/template.yaml",
        "logicalId": "HelloWorldFunction"
      },
      "lambda": {
        "payload": {},
        "environmentVariables": {},
        "runtime": "nodejs24.x"
      }
    },
    {
      "type": "aws-sam",
      "request": "direct-invoke",
      "name": "API micro-quiz-v2:HelloWorldFunction (nodejs24.x)",
      "invokeTarget": {
        "target": "api",
        "templatePath": "${workspaceFolder}/src/micro-quiz-v2/template.yaml",
        "logicalId": "HelloWorldFunction"
      },
      "api": {
        "path": "/hello",
        "httpMethod": "get",
        "payload": {
          "json": {}
        }
      },
      "lambda": {
        "runtime": "nodejs24.x"
      }
    },
    {
      "type": "aws-sam",
      "request": "direct-invoke",
      "name": "micro-quiz-v2:AnswerSubmissionFunction (nodejs24.x)",
      "invokeTarget": {
        "target": "template",
        "templatePath": "${workspaceFolder}/src/micro-quiz-v2/template.yaml",
        "logicalId": "AnswerSubmissionFunction"
      },
      "lambda": {
        "payload": {},
        "environmentVariables": {},
        "runtime": "nodejs24.x"
      },
      "sourceRoot": "${workspaceFolder}/src/micro-quiz-v2/answer-submission"
    },
    {
      "type": "aws-sam",
      "request": "direct-invoke",
      "name": "API micro-quiz-v2:AnswerSubmissionFunction (nodejs24.x)",
      "invokeTarget": {
        "target": "api",
        "templatePath": "${workspaceFolder}/src/micro-quiz-v2/template.yaml",
        "logicalId": "AnswerSubmissionFunction"
      },
      "api": {
        "path": "/answer-submission",
        "httpMethod": "post",
        "payload": {
          "json": {}
        }
      },
      "lambda": {
        "runtime": "nodejs24.x"
      },
      "sourceRoot": "${workspaceFolder}/src/micro-quiz-v2/answer-submission"
    }
  ]
}