{
  "compounds": [
    {
      "name": "Local: answer-submission + grading-scheduler",
      "configurations": [
        "Answer Submission: local (no Docker)",
        "Grading Scheduler: local (no Docker)"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Answer Submission: local (no Docker)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/micro-quiz-v2/answer-submission/dist/answer-submission/local-server.js",
      "cwd": "${workspaceFolder}/src/micro-quiz-v2/answer-submission",
      "preLaunchTask": "tsc: build answer-submission",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/micro-quiz-v2/answer-submission/dist/**/*.js"],
      "env": {
        "TABLE_NAME": "quiz-answers",
        "AWS_ENDPOINT_URL": "http://localhost:4566",
        "AWS_ACCESS_KEY_ID": "test",
        "AWS_SECRET_ACCESS_KEY": "test",
        "AWS_REGION": "us-east-1"
      }
    },
    {
      "name": "Grading Scheduler: local (no Docker)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/micro-quiz-v2/grading-scheduler/dist/grading-scheduler/local-runner.js",
      "cwd": "${workspaceFolder}/src/micro-quiz-v2/grading-scheduler",
      "preLaunchTask": "tsc: build grading-scheduler",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/micro-quiz-v2/grading-scheduler/dist/**/*.js"],
      "env": {
        "TABLE_NAME": "quiz-answers",
        "AWS_ENDPOINT_URL": "http://localhost:4566",
        "AWS_ACCESS_KEY_ID": "test",
        "AWS_SECRET_ACCESS_KEY": "test",
        "AWS_REGION": "us-east-1"
      }
    },
    {
      "name": "SAM: start local API",
      "type": "node-terminal",
      "request": "launch",
      "command": "sam local start-api -d 5858 --env-vars env.local.json",
      "cwd": "${workspaceFolder}/src/micro-quiz-v2",
      "preLaunchTask": "sam: build"
    },
    {
        "name": "Attach to SAM Local",
        "type": "node",
        "request": "attach",
        "address": "127.0.0.1",
        "port": 5858,
        "localRoot": "${workspaceFolder}/src/micro-quiz-v2/.aws-sam/build/AnswerSubmissionFunction",
        "remoteRoot": "/var/task",
        "sourceMaps": true,
        "sourceMapPathOverrides": {
            "../*": "${workspaceFolder}/src/micro-quiz-v2/answer-submission/*"
        }
    }
  ]
}